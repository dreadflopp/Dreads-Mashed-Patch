<Window x:Class="DreadsMashedPatch.App.InstallationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Skyrim installation"
        Style="{StaticResource AppWindowStyle}"
        Icon="Assets/AppIcon.png"
        Width="680"
        Height="360"
        MinWidth="520"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Several Skyrim installations were found" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Choose the installation this patcher should use. Wabbajack Stock Game folders can be selected manually from the General tab." />
        </StackPanel>

        <ListBox x:Name="InstallationList" Grid.Row="1" MouseDoubleClick="OnInstallationDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Skyrim installations">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="7,5">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding GameFolder}" TextWrapping="Wrap" ToolTip="{Binding GameFolder}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Use installation" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnUseInstallation" />
        </StackPanel>
    </Grid>
</Window>
