<Window x:Class="DreadsMashedPatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="Mashed Patch"
        Style="{StaticResource AppWindowStyle}"
        Icon="Assets/AppIcon.png"
        Width="1040"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <system:String x:Key="GamePathDescription">Contains SkyrimSE.exe.</system:String>
        <system:String x:Key="DataPathDescription">Usually located inside your Skyrim game folder.</system:String>
        <system:String x:Key="LoadOrderDescription">Select the plugins.txt file used by your active profile or game installation.</system:String>
        <system:String x:Key="OutputPathDescription">Stores the generated patch plugins. With MO2 or Amethyst, create an empty mod for the patch using your mod manager's interface, then select that mod's folder.</system:String>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Mashed Patch"
                               Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ProgressBar Width="90"
                                 Height="7"
                                 Margin="0,0,12,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentBrush}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ElapsedText}"
                               Foreground="{DynamicResource HeaderMutedTextBrush}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Margin="16,14,16,8"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Theme"/>
                        <ComboBox x:Name="ThemeSelector"
                                  ItemsSource="{Binding ThemeChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Theme}"
                                  Width="220" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Theme"/>

                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Game paths" Margin="0,20,0,0"/>

                        <Border Background="{DynamicResource InfoPanelBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="Mod Organizer 2 / Amethyst"
                                           FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    <Run Text=" Add the patcher as an executable in the mod manager"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource InfoPanelBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="Wabbajack / Stock Game"
                                           FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="If your list uses a copy of Skyrim in a stock folder, select that folder."
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Detect paths"
                                Click="OnAutoDetectPaths"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,7"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Game release"/>
                        <ComboBox ItemsSource="{Binding GameReleaseChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.GameRelease}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,5">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Skyrim game folder" />
                            <Label Style="{StaticResource PathHelpBadge}"
                                   AutomationProperties.Name="Skyrim game folder help"
                                   AutomationProperties.HelpText="{StaticResource GamePathDescription}">
                                <Label.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{StaticResource GamePathDescription}"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Steam:"/>
                                            <Run Text=" Your Steam library → steamapps → common → Skyrim Special Edition"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="MO2 Stock Game example:"/>
                                            <Run Text=" Your mod list folder → Stock Game"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Amethyst Stock Game example:"/>
                                            <Run Text=" Your Amethyst game folder → .wj → your mod list → root → Stock Game"/>
                                            <LineBreak/>
                                        </TextBlock>
                                    </ToolTip>
                                </Label.ToolTip>
                            </Label>
                        </StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse…"
                                    Click="OnBrowseGameFolder"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.GameFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,5">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Data folder" />
                            <Label Style="{StaticResource PathHelpBadge}"
                                   AutomationProperties.Name="Data folder help"
                                   AutomationProperties.HelpText="{StaticResource DataPathDescription}">
                                <Label.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="{StaticResource DataPathDescription}" TextWrapping="Wrap"/>
                                    </ToolTip>
                                </Label.ToolTip>
                            </Label>
                        </StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse…"
                                    Click="OnBrowseDataFolder"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.DataFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,5">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Plugins.txt" />
                            <Label Style="{StaticResource PathHelpBadge}"
                                   AutomationProperties.Name="Plugins.txt help"
                                   AutomationProperties.HelpText="{StaticResource LoadOrderDescription}">
                                <Label.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{StaticResource LoadOrderDescription}"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="MO2 example:"/>
                                            <Run Text=" Your MO2 instance folder → profiles → your active profile → plugins.txt"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Amethyst example:"/>
                                            <Run Text=" Your Amethyst game folder → profiles → your active profile → plugins.txt"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Without a mod manager:"/>
                                            <Run Text=" Your Windows user folder → AppData → Local → Skyrim Special Edition → plugins.txt."/>
                                            <LineBreak/>
                                        </TextBlock>
                                    </ToolTip>
                                </Label.ToolTip>
                            </Label>
                        </StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse…"
                                    Click="OnBrowseLoadOrder"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.LoadOrderFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,5">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Output folder" />
                            <Label Style="{StaticResource PathHelpBadge}"
                                   AutomationProperties.Name="Patch output folder help"
                                   AutomationProperties.HelpText="{StaticResource OutputPathDescription}">
                                <Label.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{StaticResource OutputPathDescription}"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="MO2 example:"/>
                                            <Run Text=" Your MO2 instance folder → mods → Mashed Patch"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Amethyst example:"/>
                                            <Run Text=" Your Amethyst game folder → mods → Mashed Patch"/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Text="Without a mod manager:"/>
                                            <Run Text=" Select your Skyrim installation's Data folder."/>
                                        </TextBlock>
                                    </ToolTip>
                                </Label.ToolTip>
                            </Label>
                        </StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseOutputFolder" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <Button Content="Verify paths"
                                Click="OnVerifyPaths"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0"/>
                        <TextBlock x:Name="PathVerificationSummary" Text="Paths have not been verified."
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"/>
                        <Expander x:Name="PathVerificationDetails" Header="Path verification details" Visibility="Collapsed">
                            <TextBox x:Name="PathVerificationReport" IsReadOnly="True" AcceptsReturn="True"
                                     Height="260" VerticalContentAlignment="Top" Style="{StaticResource MonospaceTextBox}"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Path verification report"/>
                        </Expander>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Initial load-order placement"/>
                        <Button Content="Create empty patch output"
                                Click="OnCreateEmptyOutput"
                                HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Replaces existing patch plugins in the selected output folder with one empty plugin. Enable it and set its load-order position before the first full run."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Record Types">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Record families"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="The patcher processes only the enabled record families."/>
                        <Border Background="{DynamicResource InfoPanelBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,9"
                                Margin="0,3,0,8">
                            <StackPanel>
                                <TextBlock Text="Disabled by default"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,1">
                                    <Run FontWeight="SemiBold" Text="Dialogue records (DIAL, DLBR, INFO, DLVW)"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,1">
                                    <Run FontWeight="SemiBold" Text="Navigation meshes (NAVM)"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,1">
                                    <Run FontWeight="SemiBold" Text="Packages (PACK):"/>
                                    <Run Text=" A Mutagen bug can rearrange package data when the patch is written. Leave this disabled until the bug is fixed."/>
                                </TextBlock>
                                <TextBlock Text="You can still enable these record types, but check the resulting overrides in xEdit."
                                           TextWrapping="Wrap"
                                           FontStyle="Italic"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,10">
                        <Button Content="Enable all"
                                Click="OnEnableAll"/>
                        <Button Content="Disable all"
                                Click="OnDisableAll"/>
                        <Button Content="Invert"
                                Click="OnInvert"
                                Margin="0"/>
                    </StackPanel>
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource PanelBrush}"
                                    Padding="10,7"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding SelectedRecordTypeCountText}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <ListBox x:Name="RecordTypeList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding RecordTypes}"
                                     BorderThickness="0"
                                     SelectionMode="Extended"
                                     PreviewKeyDown="OnRecordTypeListPreviewKeyDown"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Record types">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              ToolTip="{Binding DisplayName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Focusable="False"
                                                      Width="36"
                                                      Height="30"
                                                      Margin="2,0,8,0"
                                                      HorizontalContentAlignment="Center"
                                                      AutomationProperties.Name="{Binding DisplayName}"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Signature}"
                                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                                           FontWeight="SemiBold"
                                                           Width="55"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           MinWidth="240"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Priority Mods">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Mods that always win"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="When a listed plugin edits a record but is not the winning override, the patch copies that plugin's entire record unchanged. If multiple listed plugins edit the same record, the last of those plugins in this list wins."/>
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Plugin filenames"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Enter one full plugin filename per line, including .esp, .esm, or .esl."/>
                        <TextBox Text="{Binding AlwaysWinningModsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 MinWidth="520"
                                 MinHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource MonospaceTextBox}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ignored Mods">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Mods excluded from conflict discovery"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Ignored plugins are excluded when the patcher determines which values to forward."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Plugin filenames"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Enter one complete plugin filename per line, including .esm, .esp, or .esl."/>
                        <TextBox Height="180"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding IgnoredModsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Smart Forwarding">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Smarter choices for complex records"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="These options apply specialized forwarding rules,"/>

                        <CheckBox Content="Treat Creation Club content as official baseline"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Forwarding.TreatCreationClubAsVanilla}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Recommended. Treats Creation Club plugins like Bethesda's base-game files, so their original values are not mistaken for ordinary mod changes."/>

                        <CheckBox Content="Keep one vanilla weapon type keyword"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Forwarding.EnforceSingleVanillaWeaponTypeKeyword}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="When the patcher accepts a mod's change to exactly one configured vanilla weapon-type keyword, it also removes the other configured vanilla weapon types. Other keywords are unaffected. Overrides that intentionally contain several configured vanilla types are preserved."/>
                        <Expander Header="Configured vanilla weapon type keywords"
                                  Margin="0,4,0,10"
                                  IsExpanded="False">
                            <StackPanel Margin="18,8,0,0">
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="One FormKey per line, in 000000:Plugin.ext format. These keywords are treated as mutually exclusive weapon types."/>
                                <TextBox Text="{Binding VanillaWeaponTypeKeywordsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinWidth="420"
                                         MinHeight="145"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MonospaceTextBox}"/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Editor IDs (EDID)"/>
                        <ComboBox ItemsSource="{Binding EditorIdPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.EditorIdPolicy}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Recommended: forward a changed Editor ID only when another property already requires a patch record."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="NPC protection status"/>
                        <ComboBox ItemsSource="{Binding ProtectionPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.ProtectionPolicy}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Avoids accidentally making an Essential or Protected NPC vulnerable while still allowing a later mod to change the status deliberately."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Tamriel persistent cell (000D74:Skyrim.esm)"/>
                        <ComboBox ItemsSource="{Binding TamrielPersistentCellPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.TamrielPersistentCellPolicy}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Recommended hybrid: patch normally unless the winning CELL header matches Skyrim.esm, then use Dawnguard.esm instead."/>

                        <CheckBox Content="Restrict tree forwarding (Recommended)"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Forwarding.RestrictTreeForwarding}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Does not forward tree models, bounds, wind settings, scripts or record flags from other overrides. Keeps these fields from the winning plugin to avoid mixing incompatible tree appearance and behavior. Uncheck to use normal forwarding."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Master Rules">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Virtual master rules"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="A mod is normally allowed to revert another plugin's changes only when that plugin is one of its declared masters. Select or add a mod, then list the additional plugins it should treat as masters during forwarding. No plugin files are modified."/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource InfoPanelBrush}"
                            BorderBrush="{DynamicResource InfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Default master rules"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,8"
                                       Text="Import replaces the current list. Export saves the master rules as a portable file. Default settings include curated rules."/>
                            <WrapPanel>
                                <Button Content="Import rules…"
                                        Click="OnImportCompatibilityRules"/>
                                <Button Content="Export rules…"
                                        Click="OnExportCompatibilityRules"/>
                                <Button Content="Restore default rules"
                                        Click="OnRestoreDefaultCompatibilityRules"
                                        Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" MaxWidth="260"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="Add rule"
                                        Click="OnAddCompatibilityRule"/>
                                <Button Content="Remove"
                                        Click="OnRemoveCompatibilityRule"
                                        Margin="0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding CompatibilityRules}"
                                     SelectedItem="{Binding SelectedCompatibilityRule}"
                                     DisplayMemberPath="DisplayName"
                                     AutomationProperties.Name="Master rules"/>
                        </DockPanel>

                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid DataContext="{Binding SelectedCompatibilityRule}"
                                      MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                                               Text="Mod"/>
                                    <TextBox Grid.Row="1" Text="{Binding TargetMod, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Rule target mod"
                                             ToolTip="For example: Lux.esp"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource HelpText}"
                                               Text="Use the complete plugin filename, including .esm, .esp, or .esl."/>

                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}"
                                               Text="Additional virtual masters for this mod"/>
                                    <TextBox Grid.Row="4" MinHeight="120"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding VirtualMastersText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Additional virtual masters"
                                             ToolTip="Enter one complete plugin filename per line."/>
                                    <TextBlock Grid.Row="5" Style="{StaticResource HelpText}"
                                               Text="Enter one complete plugin filename per line. This mod may intentionally restore values changed by these plugins. A rule with no virtual masters has no effect."/>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Logging and deep-dive diagnostics"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Warnings and run progress are always shown. Debug mode adds property-level decisions and optional deep-dive logging. Use deep dives for more detail about specific records or record families. Logging an entire family can create very large log files."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Historical logs to keep"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Use 0 to retain only the current log."/>
                        <TextBox Width="120"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,12"
                                 Text="{Binding Settings.HistoricalLogsToKeep, UpdateSourceTrigger=LostFocus}"/>

                        <CheckBox x:Name="DebugModeCheck"
                                  Content="Enable debug mode"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Diagnostics.DebugMode}"/>

                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=DebugModeCheck}"
                                    Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Verbosity"/>
                            <ComboBox ItemsSource="{Binding LogVerbosityChoices}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.Patcher.Diagnostics.Verbosity}"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Maximum value preview length"/>
                            <TextBox Width="120"
                                     HorizontalAlignment="Left"
                                     Text="{Binding Settings.Patcher.Diagnostics.MaxValuePreviewLength, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Deep-dive record signatures"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="One xEdit record signature per line, for example QUST."/>
                            <TextBox Height="72"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDiveRecordSignaturesText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Deep-dive FormKeys"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="One FormKey per line, for example 00285D:Update.esm. Bare hexadecimal FormIDs are also accepted."/>
                            <TextBox Height="72"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDiveFormKeysText, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RunLogTab"
                     Header="Run Log">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Copy visible messages"
                                Click="OnCopyLog"
                                Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right"
                                Content="Open logs folder"
                                Click="OnOpenLogsFolder"
                                Margin="8,0,0,0"/>
                        <TextBlock Text="Progress, warnings, and errors"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="RunLogTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Style="{StaticResource MonospaceTextBox}"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Patcher run log"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,11">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Save settings"
                        Click="OnSave">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Run patcher"
                        Click="OnRun"
                        Margin="0">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
