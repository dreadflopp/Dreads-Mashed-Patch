<Window x:Class="DreadsMashedPatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mashed Patch"
        Style="{StaticResource AppWindowStyle}"
        Icon="Assets/AppIcon.png"
        Width="1040"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Mashed Patch"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ProgressBar Width="90"
                                 Height="7"
                                 Margin="0,0,12,0"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ElapsedText}"
                               Foreground="{StaticResource HeaderMutedTextBrush}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Margin="16,14,16,8"
                    Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Game paths"/>

                        <Border Background="{StaticResource InfoPanelBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="Mod manager setup"
                                           FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    <Run FontWeight="SemiBold" Text="MO2:"/>
                                    <Run Text=" Add the patcher as an executable in MO2 and launch it through MO2 so it can access your active profile's virtual files."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Amethyst:"/>
                                    <Run Text=" Deploy your active profile before running the patcher."/>
                                </TextBlock>
                                <TextBlock Text="Use the normal-install examples unless your list uses Stock Game or Game Root. Steam libraries, GOG installations, and manager folders may be elsewhere; browse to your actual installation and active profile."
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InfoPanelBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}"
                                BorderThickness="2" CornerRadius="4" Padding="12" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="Wabbajack / Stock Game: select the game installation your list uses"
                                           FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="If your list uses a copied installation, select that game folder and its Data folder. Otherwise, select your normal Steam or GOG installation. Detect paths may find the Steam installation instead. Select the active profile's plugins.txt, then verify the paths before patching."
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Detect paths"
                                    Click="OnAutoDetectPaths"
                                    HorizontalAlignment="Left"
                                    Margin="0,5,0,7"/>
                            <Button Content="Verify paths" Click="OnVerifyPaths" Margin="8,5,0,7"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Game release"/>
                        <ComboBox ItemsSource="{Binding GameReleaseChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.GameRelease}"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Skyrim game folder"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse…"
                                    Click="OnBrowseGameFolder"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.GameFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HelpText}">
                            <Run Text="Contains SkyrimSE.exe or SkyrimVR.exe and, when present, Skyrim.ccc."/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Normal installation (Windows):"/>
                            <Run Text=" C:\Program Files (x86)\Steam\steamapps\common\Skyrim Special Edition"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Normal installation (Proton):"/>
                            <Run Text=" Z:\home\&lt;username&gt;\.local\share\Steam\steamapps\common\Skyrim Special Edition"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="MO2 Stock Game example:"/>
                            <Run Text=" C:\Modlists\&lt;list name&gt;\Stock Game"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Amethyst Game Root example (Proton):"/>
                            <Run Text=" Z:\home\&lt;username&gt;\Games\Amethyst\Skyrim Special Edition\.wj\&lt;list name&gt;\root\Game Root"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Data folder"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse…"
                                    Click="OnBrowseDataFolder"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.DataFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HelpText}">
                            <Run Text="Contains the plugins used by your game or mod list."/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Normal installation (Windows):"/>
                            <Run Text=" C:\Program Files (x86)\Steam\steamapps\common\Skyrim Special Edition\Data"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Normal installation (Proton):"/>
                            <Run Text=" Z:\home\&lt;username&gt;\.local\share\Steam\steamapps\common\Skyrim Special Edition\Data"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="MO2 Stock Game example:"/>
                            <Run Text=" C:\Modlists\&lt;list name&gt;\Stock Game\Data"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Amethyst Game Root example (Proton):"/>
                            <Run Text=" Z:\home\&lt;username&gt;\Games\Amethyst\Skyrim Special Edition\.wj\&lt;list name&gt;\root\Game Root\Data"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Load order file (plugins.txt)"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse…"
                                    Click="OnBrowseLoadOrder"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.LoadOrderFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HelpText}">
                            <Run Text="Select the plugins.txt file used by your active profile or game installation."/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="MO2 example:"/>
                            <Run Text=" C:\Modding\MO2\profiles\&lt;profile name&gt;\plugins.txt"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Amethyst example (Proton):"/>
                            <Run Text=" Z:\home\&lt;username&gt;\Games\Amethyst\Skyrim Special Edition\profiles\&lt;profile name&gt;\plugins.txt"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Without a mod manager:"/>
                            <Run Text=" Look in %LOCALAPPDATA%\Skyrim Special Edition\plugins.txt, or the corresponding GOG or VR folder."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Patch output folder"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseOutputFolder" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Settings.OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HelpText}">
                            <Run Text="Stores the generated patch plugins. With MO2 or Amethyst, create an empty mod for the patch using your mod manager's interface, then select that mod's folder."/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="MO2 example:"/>
                            <Run Text=" C:\Modding\MO2\mods\Mashed Patch"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Amethyst example (Proton):"/>
                            <Run Text=" Z:\home\&lt;username&gt;\Games\Amethyst\Skyrim Special Edition\mods\Mashed Patch"/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Without a mod manager:"/>
                            <Run Text=" Select your Skyrim installation's Data folder."/>
                        </TextBlock>

                        <TextBlock x:Name="PathVerificationSummary" Text="Paths have not been verified."
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"/>
                        <Expander x:Name="PathVerificationDetails" Header="Path verification details" Visibility="Collapsed">
                            <TextBox x:Name="PathVerificationReport" IsReadOnly="True" AcceptsReturn="True"
                                     Height="260" VerticalContentAlignment="Top" Style="{StaticResource MonospaceTextBox}"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Path verification report"/>
                        </Expander>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Initial load-order placement"/>
                        <Button Content="Create empty patch output"
                                Click="OnCreateEmptyOutput"
                                HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Replaces existing patch plugins in the selected output folder with one empty plugin. Enable it and set its load-order position before the first full run."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Record Types">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Record families"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="The patcher processes only the enabled record families."/>
                        <Border Background="{StaticResource InfoPanelBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,9"
                                Margin="0,3,0,8">
                            <StackPanel>
                                <TextBlock Text="Disabled by default"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,1">
                                    <Run FontWeight="SemiBold" Text="Dialogue records (DIAL, DLBR, INFO, DLVW):"/>
                                    <Run Text=" These records depend on one another, and mixing parts from different mods can break conversations."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,1">
                                    <Run FontWeight="SemiBold" Text="Navigation meshes (NAVM):"/>
                                    <Run Text=" These records control where characters can walk. Mixing data from different mods can create broken paths."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,1">
                                    <Run FontWeight="SemiBold" Text="Packages (PACK):"/>
                                    <Run Text=" A Mutagen bug can rearrange package data when the patch is written. Leave this disabled until the bug is fixed."/>
                                </TextBlock>
                                <TextBlock Text="You can still enable these record types, but check the resulting overrides in xEdit."
                                           TextWrapping="Wrap"
                                           FontStyle="Italic"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,10">
                        <Button Content="Enable all"
                                Click="OnEnableAll"/>
                        <Button Content="Disable all"
                                Click="OnDisableAll"/>
                        <Button Content="Invert"
                                Click="OnInvert"
                                Margin="0"/>
                    </StackPanel>
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelBrush}"
                                    Padding="10,7"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding SelectedRecordTypeCountText}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <ListBox x:Name="RecordTypeList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding RecordTypes}"
                                     BorderThickness="0"
                                     SelectionMode="Extended"
                                     PreviewKeyDown="OnRecordTypeListPreviewKeyDown"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Record types">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              ToolTip="{Binding DisplayName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Focusable="False"
                                                      Width="36"
                                                      Height="30"
                                                      Margin="2,0,8,0"
                                                      HorizontalContentAlignment="Center"
                                                      AutomationProperties.Name="{Binding DisplayName}"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Signature}"
                                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                                           FontWeight="SemiBold"
                                                           Width="55"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           MinWidth="240"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Priority Mods">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Mods that always win"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="When a listed plugin edits a record but is not the winning override, the patch copies that plugin's entire record unchanged. If multiple listed plugins edit the same record, the last of those plugins in this list wins."/>
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Plugin filenames"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Enter one full plugin filename per line, including .esp, .esm, or .esl. Order matters: entries lower in the list have higher priority."/>
                        <TextBox Text="{Binding AlwaysWinningModsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 MinWidth="520"
                                 MinHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource MonospaceTextBox}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ignored Mods">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Mods excluded from conflict discovery"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Ignored plugins are excluded when the patcher determines which values to forward."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Plugin filenames"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Enter one complete plugin filename per line, including .esm, .esp, or .esl."/>
                        <TextBox Height="180"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding IgnoredModsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Smart Forwarding">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Smarter choices for complex records"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="These options apply specialized forwarding rules to fields that cannot always be merged safely by the general rules."/>

                        <CheckBox Content="Treat Creation Club content as official baseline"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Forwarding.TreatCreationClubAsVanilla}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Recommended. Treats Creation Club plugins like Bethesda's base-game files, so their original values are not mistaken for ordinary mod changes."/>

                        <CheckBox Content="Keep one vanilla weapon type keyword"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Forwarding.EnforceSingleVanillaWeaponTypeKeyword}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="When the patcher accepts a mod's change to exactly one configured vanilla weapon-type keyword, it also removes the other configured vanilla weapon types. Other keywords are unaffected. Overrides that intentionally contain several configured vanilla types are preserved."/>
                        <Expander Header="Configured vanilla weapon type keywords"
                                  Margin="0,4,0,10"
                                  IsExpanded="False">
                            <StackPanel Margin="18,8,0,0">
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="One FormKey per line, in 000000:Plugin.ext format. These keywords are treated as mutually exclusive weapon types."/>
                                <TextBox Text="{Binding VanillaWeaponTypeKeywordsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinWidth="420"
                                         MinHeight="145"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MonospaceTextBox}"/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Editor IDs (EDID)"/>
                        <ComboBox ItemsSource="{Binding EditorIdPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.EditorIdPolicy}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Recommended: forward a computed Editor ID only when another property already requires a patch record. This preserves relevant renames without creating EDID-only overrides."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="NPC protection status"/>
                        <ComboBox ItemsSource="{Binding ProtectionPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.ProtectionPolicy}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Avoids accidentally making an Essential or Protected NPC vulnerable while still allowing a later mod to change the status deliberately."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Tamriel persistent cell (000D74:Skyrim.esm)"/>
                        <ComboBox ItemsSource="{Binding TamrielPersistentCellPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.TamrielPersistentCellPolicy}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Recommended hybrid: patch normally unless the winning CELL header matches Skyrim.esm, then use Dawnguard.esm instead."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Master Rules">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Virtual master rules"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="A mod is normally allowed to revert another plugin's changes only when that plugin is one of its declared masters. Select or add a mod, then list the additional plugins it should treat as masters during forwarding. No plugin files are modified."/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource InfoPanelBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Margin="12,0,0,0">
                                <Button Content="Import rules…"
                                        Click="OnImportCompatibilityRules"/>
                                <Button Content="Export rules…"
                                        Click="OnExportCompatibilityRules"/>
                                <Button Content="Restore default rules"
                                        Click="OnRestoreDefaultCompatibilityRules"
                                        Margin="0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="Default master rules"/>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Margin="0,3,0,0"
                                           Text="Import replaces the current list. Export saves the master rules as a portable file. Default settings include curated rules."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="Add rule"
                                        Click="OnAddCompatibilityRule"/>
                                <Button Content="Remove"
                                        Click="OnRemoveCompatibilityRule"
                                        Margin="0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding CompatibilityRules}"
                                     SelectedItem="{Binding SelectedCompatibilityRule}"
                                     DisplayMemberPath="DisplayName"
                                     AutomationProperties.Name="Master rules"/>
                        </DockPanel>

                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="14">
                            <StackPanel DataContext="{Binding SelectedCompatibilityRule}">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="Mod"/>
                                <TextBox Text="{Binding TargetMod, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="For example: Lux.esp"/>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="Use the complete plugin filename, including .esm, .esp, or .esl."/>

                                 <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="Additional virtual masters for this mod"/>
                                <TextBox Height="230"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding VirtualMastersText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter one complete plugin filename per line."/>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="Enter one complete plugin filename per line. This mod may intentionally restore values changed by these plugins. A rule with no virtual masters has no effect."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="18">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Logging and deep-dive diagnostics"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Warnings and run progress are always shown. Debug mode adds property-level decisions and optional deep-dive logging. Use deep dives for more detail about specific records or record families. Logging an entire family can create very large log files."/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Historical logs to keep"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Use 0 to retain only the current log."/>
                        <TextBox Width="120"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,12"
                                 Text="{Binding Settings.HistoricalLogsToKeep, UpdateSourceTrigger=LostFocus}"/>

                        <CheckBox x:Name="DebugModeCheck"
                                  Content="Enable debug mode"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Diagnostics.DebugMode}"/>

                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=DebugModeCheck}"
                                    Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Verbosity"/>
                            <ComboBox ItemsSource="{Binding LogVerbosityChoices}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.Patcher.Diagnostics.Verbosity}"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Maximum value preview length"/>
                            <TextBox Width="120"
                                     HorizontalAlignment="Left"
                                     Text="{Binding Settings.Patcher.Diagnostics.MaxValuePreviewLength, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Deep-dive record signatures"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="One xEdit record signature per line, for example QUST."/>
                            <TextBox Height="72"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDiveRecordSignaturesText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Deep-dive FormKeys"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="One FormKey per line, for example 00285D:Update.esm. Bare hexadecimal FormIDs are also accepted."/>
                            <TextBox Height="72"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDiveFormKeysText, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RunLogTab"
                     Header="Run Log">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Copy visible messages"
                                Click="OnCopyLog"
                                Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right"
                                Content="Open logs folder"
                                Click="OnOpenLogsFolder"
                                Margin="8,0,0,0"/>
                        <TextBlock Text="Progress, warnings, and errors"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="RunLogTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Style="{StaticResource MonospaceTextBox}"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Patcher run log"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,11">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Save settings"
                        Click="OnSave">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Run patcher"
                        Click="OnRun"
                        Margin="0">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
